					<comments>https://www.savagechickens.com/2026/08/surrounded-2.html#comments</comments>

		<dc:creator><![CDATA[Doug]]></dc:creator>
		<pubDate>Fri, 28 Aug 2026 07:01:54 +0000</pubDate>
				<category><![CDATA[Cartoons]]></category>
		<category><![CDATA[Road Comics]]></category>
