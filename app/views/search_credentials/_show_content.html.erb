<%# locals: (search_credential:, feed_id: nil) %>
<%= render CredentialShowComponent.new(
      credential: search_credential,
      key: "search_credential",
      breadcrumb: "Search credentials",
      breadcrumb_url: search_credentials_path,
      checking_note: "This makes one small search request and usually takes a few seconds.",
      rejected_note: "This key didn't work. Get a fresh key from your search provider and replace it.",
      feed_id: feed_id) do |page| %>
  <% page.with_details do %>
    <%= render SearchCredentialDetailsComponent.new(search_credential: search_credential) %>
  <% end %>
  <% page.with_settled_extra do %>
    <section class="space-y-4" data-key="search_credential.usage">
      <%= h2 "Search usage" %>
      <%= render SearchCredentialUsageStatsComponent.new(search_credential: search_credential) %>
    </section>
  <% end %>
<% end %>
