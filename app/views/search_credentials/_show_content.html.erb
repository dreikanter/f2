<%# locals: (search_credential:, feed_id: nil) %>
<div class="space-y-6" data-key="search_credential.show">
  <%= render PageHeaderComponent.new(title: search_credential.display_name) do |header| %>
    <% header.with_breadcrumb(label: "Search credentials", url: search_credentials_path) %>
    <% unless search_credential.validation_in_progress? %>
      <% header.with_context_paragraph do %>
        <%= render credential_state_badge(search_credential) %>
      <% end %>
    <% end %>
    <% header.with_action_button do %>
      <%= render HeaderMenuComponent.new(
        menu_id: "search-credential-header-menu-#{search_credential.id}",
        items: credential_actions_menu_items(search_credential)
      ) %>
    <% end %>
  <% end %>

  <%= render CredentialDeleteModalComponent.new(credential: search_credential) %>

  <% if search_credential.active? && search_credential.validation_error.present? %>
    <%= render AlertComponent.new(variant: :warning, data: { key: "search_credential.validation_error" }) do %>
      <%= search_credential.validation_error %>
    <% end %>
  <% end %>

  <% if search_credential.validation_in_progress? %>
    <%# aria-busy disables pointer events, so it stays on the waiting block;
        on the page it would take the breadcrumb and menus down with it. %>
    <div class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3"
         data-key="search_credential.validating" aria-busy="true">
      <div class="flex-shrink-0"><%= render SpinnerComponent.new %></div>
      <div class="space-y-1">
        <p class="font-semibold text-heading">Checking your credential…</p>
        <p class="text-body">This makes one small search request and usually takes a few seconds.</p>
      </div>
    </div>
  <% elsif search_credential.active? %>
    <%= render SearchCredentialDetailsComponent.new(search_credential: search_credential) %>
  <% else %>
    <p class="max-w-2xl text-body" data-key="search_credential.inactive">
      <% if (error = search_credential.validation_error.presence || search_credential.last_error.presence) %>
        <%= error %>
      <% else %>
        This credential has not been verified. Edit it to check the key again.
      <% end %>
    </p>
    <%= render SearchCredentialDetailsComponent.new(search_credential: search_credential) %>
  <% end %>

  <% unless search_credential.validation_in_progress? %>
    <section class="space-y-4" data-key="search_credential.usage">
      <%= h2 "Search usage" %>
      <%= render SearchCredentialUsageStatsComponent.new(search_credential: search_credential) %>
    </section>
  <% end %>

  <% if feed_id.present? %>
    <div class="flex flex-wrap gap-3">
      <% if search_credential.active? %>
        <%= link_to "Continue setting up your feed",
                    edit_feed_path(feed_id),
                    class: primary_button_classes(compact: true),
                    data: { key: "search_credential.return-to" } %>
      <% else %>
        <%= link_to "Back to your feed",
                    edit_feed_path(feed_id),
                    class: secondary_button_classes(compact: true),
                    data: { key: "search_credential.return-to" } %>
      <% end %>
    </div>
  <% end %>
</div>
