<% page_title = "Posts" %>
<% content_for :title, page_title %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: page_title) do |header| %>
    <% if @feed %>
      <% group = @feed.target_group.presence %>
      <% label = @feed.display_name + (group ? " (@#{group})" : "") %>
      <% header.with_context_paragraph("Posts from #{label}.") %>
    <% else %>
      <% header.with_context_paragraph("Every publication imported from your feeds shows up here.") %>
    <% end %>
    <% if @posts.empty? %>
      <% if @feed %>
        <% header.with_context_paragraph("No posts imported yet from this feed.") %>
      <% elsif @feeds.any?(&:enabled?) %>
        <% header.with_context_paragraph("Nothing imported yet.") %>
      <% elsif @feeds.any? %>
        <% header.with_context_paragraph do %>
          No posts yet. <%= link_to "Enable one of your feeds", feeds_path, class: class_names(text_link_classes, "font-medium") %> and new content will show up here.
        <% end %>
      <% else %>
        <% header.with_context_paragraph("No posts yet. Add a feed to start importing content.") %>
      <% end %>
    <% end %>
    <% if @feeds.any? && (@posts.any? || @feed) %>
      <% header.with_action_button do %>
        <%= render FeedFilterDropdownComponent.new(
              feeds: @feeds,
              selected_feed: @feed,
              sort_params: params.permit(:sort, :direction),
              menu_id: "posts-feed-menu"
            ) %>
      <% end %>
    <% end %>
    <% if @posts.any? %>
      <% header.with_action_button do %>
        <%= render SortDropdownComponent.new(presenter: @sortable_presenter, menu_id: "posts-sort-menu") %>
      <% end %>
    <% end %>
  <% end %>

  <% if @posts.any? %>
    <%= render PostsListComponent.new(posts: @posts, show_feed: @feed.blank?) %>
  <% elsif @feeds.none? %>
    <div>
      <%= link_to "Add a feed", new_feed_path, class: primary_button_classes, data: { key: "posts.empty.new-feed" } %>
    </div>
  <% end %>

  <% if pagination_total_pages > 1 %>
    <div class="text-center text-sm text-body">
      <%= @posts.size %> of <%= pagination_total_count %> posts
    </div>
  <% end %>

  <%= render_pagination { |pagination, params| posts_path(pagination.merge(feed_id: params[:feed_id])) } %>
</div>
