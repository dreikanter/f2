<% content_for :title, "New Access Token" %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: "New Access Token") %>

  <div class="max-w-2xl">
    <%= form_with model: @access_token, url: access_tokens_path(feed_id: @feed&.id), data: { controller: "token-host", token_host_hosts_value: AccessToken::FREEFEED_HOSTS.to_json } do |form| %>
      <div class="space-y-10">
        <div class="space-y-2">
          <%= form.label :host, "FreeFeed Instance", class: form_label_classes %>
          <%= form.select :host,
                          AccessToken.host_options_for_select,
                          { selected: AccessToken::FREEFEED_HOSTS[:production][:url] },
                          {
                            class: input_field_classes,
                            autofocus: true,
                            data: {
                              token_host_target: "hostSelect",
                              action: "change->token-host#updateLink"
                            }
                          } %>
        </div>

        <%= render AlertComponent.new(variant: :info) do %>
          <p>
            Need a token? Create one in
            <%= link_to AccessToken::FREEFEED_HOSTS[:production][:token_url],
                        target: "_blank",
                        rel: "noopener",
                        class: class_names(text_link_classes, "font-medium"),
                        data: { token_host_target: "link" } do %>
              <span data-token-host-target="linkText"><%= AccessToken::FREEFEED_HOSTS[:production][:domain] %> settings</span>
            <% end %>
          </p>
        <% end %>

        <%= render AlertComponent.new(variant: :secondary) do %>
          <p>Why Feeder needs these permissions:</p>
          <ul class="list-none space-y-2">
            <li><strong><code>read-my-info</code></strong> - Allows Feeder to verify your identity and display which FreeFeed account is connected to this token.</li>
            <li><strong><code>read-users-info</code></strong> - Lets Feeder check how many subscribers your target group has.</li>
            <li><strong><code>manage-posts</code></strong> - Allows Feeder to create new posts and reposts on your behalf when publishing feed content to FreeFeed.</li>
          </ul>
        <% end %>

        <div class="space-y-2">
          <%= form.label :token, "Access Token", class: form_label_classes %>
          <%= form.text_field :token,
                              class: input_field_classes,
                              placeholder: "Paste your FreeFeed access token here",
                              required: true,
                              autocomplete: "off" %>
          <% if @access_token.errors[:token].any? %>
            <p class="text-sm text-danger"><%= @access_token.errors[:token].first %></p>
          <% end %>
        </div>

        <div class="space-y-2">
          <%= form.label :name, "Token Name (optional)", class: form_label_classes %>
          <%= form.text_field :name,
                              class: input_field_classes,
                              placeholder: "e.g., My FreeFeed Token",
                              autocomplete: "off" %>
          <p class="text-sm text-muted">
            Give this token a memorable name. If left blank, a default name will be used.
          </p>
          <% if @access_token.errors[:name].any? %>
            <p class="text-sm text-danger"><%= @access_token.errors[:name].first %></p>
          <% end %>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-start gap-4 text-body">
        <%= form.submit "Validate and Save", class: primary_button_classes %>
        <%= link_to "Cancel", (@feed ? edit_feed_path(@feed) : access_tokens_path), class: secondary_button_classes %>
      </div>
    <% end %>
  </div>
</div>
