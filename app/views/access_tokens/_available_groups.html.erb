<%# locals: (access_token:, refreshing: false, refresh_failed: false) %>
<%# While a refresh runs, this fragment hosts the polling controller: the
    groups-refresh endpoint stays silent until the background job settles, then
    replaces the whole fragment — which disconnects the poller. %>
<%= tag.div id: "available-groups", class: "space-y-4", data: refreshing ? {
      controller: "polling",
      polling_endpoint_value: access_token_groups_refresh_path(access_token),
      polling_interval_value: polling_interval_ms,
      polling_max_polls_value: polling_max_polls
    } : {} do %>
  <div class="flex flex-wrap items-center gap-3">
    <h2 class="text-2xl font-semibold text-heading">Available Groups</h2>
    <%# The form is transparent to the layout, so the control lines up with the
        heading and its timeout note wraps onto a line of its own. %>
    <%= form_with url: access_token_groups_refresh_path(access_token),
                  method: :post,
                  class: "contents",
                  data: {
                    controller: "loading-button",
                    action: "turbo:submit-start->loading-button#start turbo:submit-end->loading-button#end"
                  } do %>
      <%= render GroupsRefreshControlComponent.new(key_prefix: "access_token",
                                                   refreshing: refreshing,
                                                   available: access_token.active?,
                                                   type: "submit") %>
    <% end %>
  </div>
  <% if refresh_failed %>
    <p class="text-sm text-danger" data-key="access_token.groups-refresh-failed">
      <% if access_token.active? %>
        Couldn't refresh the list. Try again in a moment.
      <% else %>
        This token stopped working, so the list can't be refreshed. Reload the page to see the token's status.
      <% end %>
    </p>
  <% end %>
  <p class="text-body">
    This access token lets you create new posts in the following groups:
  </p>
  <% (access_token.access_token_detail&.managed_groups || []).tap do |groups| %>
    <% if groups.any? %>
      <ul class="list-disc list-inside space-y-1">
        <% groups.sort_by { _1["username"] }.each do |group| %>
          <li><%= link_to group["username"], access_token.group_url(group["username"]), target: "_blank", rel: "noopener noreferrer", class: "font-medium text-brand underline underline-offset-4 transition hover:text-brand-hover" %></li>
        <% end %>
      </ul>
    <% else %>
      <%= render EmptyStateComponent.new("No groups available for posting") %>
    <% end %>
  <% end %>
<% end %>
