<% content_for :title, "Freefeed Access Tokens" %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: "Freefeed Access Tokens") do |header| %>
    <% header.with_breadcrumb(label: "Settings", url: settings_path) %>
    <% header.with_context_paragraph("Manage your FreeFeed API tokens used for reposting content.") %>
    <% if @access_tokens.any? %>
      <% header.with_action_button do %>
        <%= link_to "New Token", new_access_token_path, class: primary_button_classes(compact: true) %>
      <% end %>
    <% else %>
      <% header.with_context_paragraph("No tokens yet. Feeder needs an access token to post to FreeFeed on your behalf, and every feed needs a working one before it can go live.") %>
    <% end %>
  <% end %>

  <% if @access_tokens.any? %>
    <%= render CredentialsListComponent.new(credentials: @access_tokens) %>
  <% else %>
    <div>
      <%= link_to "New Token", new_access_token_path, class: primary_button_classes, data: { key: "access_tokens.empty.new-token" } %>
    </div>
  <% end %>
</div>
