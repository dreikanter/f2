<% content_for :title, "Search Credential" %>

<div id="search-credential-show" class="space-y-6" data-key="admin.search_credential.show">
  <%= render PageHeaderComponent.new(title: @search_credential.display_name) do |header| %>
    <% header.with_breadcrumb(label: "Admin Panel", url: admin_path) %>
    <% unless @search_credential.validation_in_progress? %>
      <% header.with_context_paragraph do %>
        <%= render credential_state_badge(@search_credential) %>
      <% end %>
    <% end %>
    <% header.with_context_paragraph do %>
      Owner:
      <%= link_to @search_credential.user.email_address, admin_user_path(@search_credential.user), class: text_link_classes %>
    <% end %>
  <% end %>

  <% if @search_credential.active? && @search_credential.validation_error.present? %>
    <%= render AlertComponent.new(variant: :warning, data: { key: "search_credential.validation_error" }) do %>
      <%= @search_credential.validation_error %>
    <% end %>
  <% end %>

  <% if @search_credential.validation_in_progress? %>
    <div class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3"
         data-key="search_credential.validating">
      <div class="flex-shrink-0"><%= render SpinnerComponent.new %></div>
      <div class="space-y-1">
        <p class="font-semibold text-heading">Checking the credential…</p>
        <p class="text-body">This makes one small search request and usually takes a few seconds.</p>
      </div>
    </div>
  <% elsif @search_credential.active? %>
    <%= render SearchCredentialDetailsComponent.new(search_credential: @search_credential) %>
  <% else %>
    <p class="max-w-2xl text-body" data-key="search_credential.inactive">
      <% if (error = @search_credential.validation_error.presence || @search_credential.last_error.presence) %>
        <%= error %>
      <% else %>
        This key didn't pass validation.
      <% end %>
    </p>
    <%= render SearchCredentialDetailsComponent.new(search_credential: @search_credential) %>
  <% end %>

  <% unless @search_credential.validation_in_progress? %>
    <section class="space-y-4" data-key="search_credential.usage">
      <%= h2 "Search usage" %>
      <%= render SearchCredentialUsageStatsComponent.new(search_credential: @search_credential) %>
    </section>
  <% end %>
</div>
