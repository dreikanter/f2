<%# locals: (ai_credential:) %>
<% refreshing = ai_credential.models_refreshing? %>
<%= tag.div class: "space-y-3", data: { model_catalog_done: refreshing ? nil : true } do %>
  <div>
    <div class="flex items-start gap-2">
      <h2 class="text-2xl font-semibold mb-3 text-heading">Available models</h2>
      <%= form_with url: ai_credential_model_catalog_path(ai_credential),
                    class: "flex shrink-0",
                    data: {
                      controller: "loading-button",
                      action: "turbo:submit-start->loading-button#start turbo:submit-end->loading-button#end"
                    } do %>
        <%= render RefreshButtonComponent.new(title: "Refresh models", loading: refreshing, compact: true, type: "submit",
                                              data: { key: "ai_credential.refresh-models" }) %>
      <% end %>
    </div>
    <p class="min-h-5 text-sm text-muted" data-key="ai_credential.models-refresh-status">
      <% if refreshing %>
        Refreshing models. Your credential and saved list remain usable.
      <% elsif ai_credential.latest_operation_run(:models_refresh)&.status.in?(%w[failed timed_out]) %>
        Couldn't refresh models. Your saved list is still available.
      <% elsif ai_credential.models_refreshed_at %>
        Updated <%= time_ago_in_words(ai_credential.models_refreshed_at) %> ago.
      <% end %>
    </p>
  </div>
  <%= render AiCredentialModelsComponent.new(ai_credential: ai_credential) %>
<% end %>
