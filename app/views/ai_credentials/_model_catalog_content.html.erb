<%# locals: (ai_credential:, feed_id: nil) %>
<% refreshing = llm_models_refreshing? %>
<div class="space-y-3">
  <div>
    <div class="flex items-start gap-2">
      <%= h2 "Available models" %>
      <%= form_with url: ai_credential_model_catalog_path(ai_credential, feed_id: feed_id),
                    class: "flex shrink-0",
                    data: {
                      controller: "loading-button",
                      action: "turbo:submit-start->loading-button#start turbo:submit-end->loading-button#end"
                    } do %>
        <%= render RefreshButtonComponent.new(title: "Refresh models", loading: refreshing, compact: true, type: "submit",
                                              data: { key: "ai_credential.refresh-models" }) %>
      <% end %>
    </div>
    <p class="min-h-5 text-sm text-muted" data-key="ai_credential.models-refresh-status">
      <% if refreshing %>
        Refreshing models. The current list remains available.
      <% elsif llm_models_refresh&.failed? %>
        Couldn't refresh models. The current list is still available.
      <% end %>
      <% if llm_models_refreshed_at %>
        Updated <%= time_ago_in_words(llm_models_refreshed_at) %> ago.
      <% end %>
    </p>
  </div>
  <%= render AiCredentialModelsComponent.new(ai_credential: ai_credential) %>
</div>
