<%# locals: (ai_credential:, feed_id: nil) %>
<%= render CredentialShowComponent.new(
      credential: ai_credential,
      key: "ai_credential",
      breadcrumb: "AI credentials",
      breadcrumb_url: ai_credentials_path,
      checking_note: "This usually takes a few seconds.",
      rejected_note: "This key didn't work. Grab a fresh key from your provider's dashboard and add it again.",
      feed_id: feed_id) do |page| %>
  <% page.with_details do %>
    <%= render AiCredentialDetailsComponent.new(ai_credential: ai_credential) %>
  <% end %>
  <% page.with_active_extra do %>
    <%= render "ai_credentials/model_catalog", ai_credential: ai_credential %>
  <% end %>
<% end %>
