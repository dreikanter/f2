<% content_for :title, "AI Credentials" %>

<div class="space-y-8" data-key="ai_credentials.index">
  <%= render PageHeaderComponent.new(title: "AI Credentials") do |header| %>
    <% header.with_breadcrumb(label: "Settings", url: settings_path) %>
    <% header.with_context_paragraph("Connect your AI provider keys to use AI-backed feed extraction.") %>
    <% if @credentials.any? %>
      <% header.with_action_button do %>
        <%= link_to "New Credential",
                    new_ai_credential_path,
                    class: "inline-flex items-center justify-center whitespace-nowrap rounded-md bg-brand px-4 py-2 text-base font-semibold text-on-brand shadow-sm transition hover:bg-brand-hover focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1",
                    data: { key: "ai_credentials.new-button" } %>
      <% end %>
    <% else %>
      <% header.with_context_paragraph("No AI credentials yet. Only AI-powered feeds need one, and regular feeds work without it.") %>
    <% end %>
  <% end %>

  <% if @credentials.any? %>
    <div id="ai_credentials_list">
      <%= render "list", credentials: @credentials %>
    </div>
  <% else %>
    <div>
      <%= link_to "New Credential", new_ai_credential_path, class: "inline-flex items-center justify-center whitespace-nowrap rounded-md bg-brand px-6 py-3 text-base font-semibold text-on-brand shadow-sm transition hover:bg-brand-hover focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1", data: { key: "ai_credentials.empty.new-credential" } %>
    </div>
  <% end %>
</div>
