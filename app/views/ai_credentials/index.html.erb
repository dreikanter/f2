<% content_for :title, "AI Credentials" %>

<div class="space-y-8" data-key="ai_credentials.index">
  <%= render PageHeaderComponent.new(title: "AI Credentials") do |header| %>
    <% header.with_breadcrumb(label: "Settings", url: settings_path) %>
    <% header.with_context_paragraph("Connect your AI provider keys to use AI-backed feed extraction.") %>
    <% if @credentials.any? %>
      <% header.with_action_button do %>
        <%= link_to "New Credential",
                    new_ai_credential_path,
                    class: primary_button_classes(compact: true),
                    data: { key: "ai_credentials.new-button" } %>
      <% end %>
    <% else %>
      <% header.with_context_paragraph("No AI credentials yet. Only AI-powered feeds need one, and regular feeds work without it.") %>
    <% end %>
  <% end %>

  <% if @credentials.any? %>
    <div id="ai_credentials_list">
      <%= render CredentialsListComponent.new(credentials: @credentials) %>
    </div>
  <% else %>
    <div>
      <%= link_to "New Credential", new_ai_credential_path, class: primary_button_classes, data: { key: "ai_credentials.empty.new-credential" } %>
    </div>
  <% end %>
</div>
