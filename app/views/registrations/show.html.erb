<% content_for :title, "Register" %>

<% if @invite.nil? %>
  <%= render ModalCardComponent.new do %>
    <div class="space-y-6">
      <%= h1 "This invite link doesn't look right" %>
      <p class="text-body">We couldn't find an invitation with that code. It might have been removed or copied incorrectly.</p>

      <div class="space-y-2">
        <p class="font-semibold text-heading">Already have an account?</p>
        <p class="text-body">
          <%= link_to "Sign in", new_session_path, class: class_names(text_link_classes, "font-medium") %>
          with your email and password.
        </p>
      </div>

      <div class="space-y-2">
        <p class="font-semibold text-heading">Need an invitation?</p>
        <p class="text-body">Ask someone who already uses Feeder to send you a new link.</p>
      </div>
    </div>
  <% end %>
<% elsif @invite.used? %>
  <%= render ModalCardComponent.new do %>
    <div class="space-y-6">
      <%= h1 "This invite was already used" %>
      <p class="text-body">This link has already been used to create an account.</p>

      <div class="space-y-4">
        <p class="font-semibold text-heading">Already have an account?</p>
        <ul class="list-disc space-y-1 ps-5 text-body">
          <li>
            Forgot your password?
            <%= link_to "Reset it here", new_password_path, class: class_names(text_link_classes, "font-medium") %>.
          </li>
          <li>
            Otherwise,
            <%= link_to "sign in", new_session_path, class: class_names(text_link_classes, "font-medium") %>
            with your email and password.
          </li>
        </ul>
      </div>

      <div class="space-y-4">
        <p class="font-semibold text-heading">Need a fresh invitation?</p>
        <p class="text-body">Ask the person who sent this link to share a new one.</p>
      </div>
    </div>
  <% end %>
<% else %>
  <%= render ModalCardComponent.new do %>
    <div class="space-y-6">
      <div class="space-y-4">
        <%= h1 "Create your account" %>
        <% if @invite&.created_by_user %>
          <p class="text-body">
            <%= @invite.created_by_user.name.presence || "Somebody" %> invited you to join Feeder.
          </p>
        <% end %>
      </div>
      <% @user ||= User.new %>
      <%= form_with model: @user, url: registration_path(code: params[:code]), method: :post, local: true do |form| %>
        <div class="space-y-10">
          <% if @user.errors.any? %>
            <%= render AlertComponent.new(variant: :error) do %>
              <span><%= @user.errors.full_messages.to_sentence.capitalize %></span>
            <% end %>
          <% end %>

          <div class="space-y-2">
            <%= form.label :email_address, "Email", class: form_label_classes %>
            <%= form.email_field :email_address, class: input_field_classes, required: true, autofocus: true %>
            <p class="text-sm text-muted">Only for password resets. No marketing.</p>
          </div>

          <div class="space-y-2">
            <%= form.label :password, class: form_label_classes %>
            <%= form.password_field :password, class: input_field_classes, required: true %>
            <p class="text-sm text-muted">At least <%= User::PASSWORD_MIN_LENGTH %> characters. A few random words work well.</p>
          </div>
        </div>
        <div class="mt-6 flex flex-col items-start gap-4 text-body sm:flex-row sm:items-center sm:justify-between">
          <%= form.submit "Create account", class: class_names(primary_button_classes, "w-full sm:w-auto") %>
          <span class="text-body">
            Already use Feeder?
            <%= link_to "Sign in", new_session_path, class: class_names(text_link_classes, "font-medium") %>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
