<% content_for :title, "Admin Panel" %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: "Admin Panel") %>

  <section class="space-y-4">
    <%= render GlobalStatsComponent.new %>
    <%= render PostsHeatmapComponent.new %>
  </section>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <%= render LinkedCardComponent.new(
      href: admin_users_path,
      title: "Users",
      icon: "users",
      description: "Manage user accounts and permissions"
    ) %>

    <%= render LinkedCardComponent.new(
      href: admin_events_path,
      title: "Events Log",
      icon: "calendar",
      description: "View system events, logs, and activity"
    ) %>

    <%= render LinkedCardComponent.new(
      href: admin_feeds_path,
      title: "Feeds",
      icon: "layers",
      description: "Browse feeds across every account"
    ) %>
  </div>
</div>
