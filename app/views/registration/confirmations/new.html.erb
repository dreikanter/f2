<% content_for :title, "Resend Confirmation" %>

<%= render ModalCardComponent.new do %>
  <div class="space-y-6">
    <%= h1 "Resend Confirmation" %>
    <p class="text-body">Enter your email. We'll send a new confirmation link.</p>

    <%= form_with url: registration_confirmations_path, method: :post, local: true do |form| %>
      <div class="space-y-6">
        <div class="space-y-2">
          <%= form.label :email_address, "Email", class: form_label_classes %>
          <%= form.email_field :email_address, class: input_field_classes, autofocus: true, required: true %>
        </div>
      </div>

      <div class="mt-6 flex flex-col items-start justify-start gap-4 text-body sm:flex-row sm:items-center sm:justify-between">
        <%= form.submit "Send confirmation email", class: class_names(primary_button_classes, "w-full sm:w-auto") %>
        <p><%= link_to "Back to sign in", new_session_path, class: class_names(text_link_classes, "inline-block font-medium leading-loose") %></p>
      </div>
    <% end %>
  </div>
<% end %>
