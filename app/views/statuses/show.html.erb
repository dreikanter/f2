<% content_for :title, "Status" %>

<% suggest_to_add_tokens = @user.access_tokens.active.none? %>
<% suggest_adding_feeds = @user.total_feeds_count.zero? %>
<%# The window between "has a token" and "first feed enabled": every feed is
    still a draft, so the dashboard would render empty with no hint why. %>
<% draft_feeds = suggest_to_add_tokens || suggest_adding_feeds ? [] : @user.feeds.draft.order(created_at: :desc).limit(2).to_a %>
<% suggest_finishing_drafts = draft_feeds.any? && @user.feeds.where.not(state: :draft).none? %>

<div class="space-y-8">
  <% if @user.email_deactivated? %>
    <%= render AlertComponent.new(variant: :warning) do %>
      <p class="font-semibold text-heading">Your email address is not receiving our emails.</p>
      <% if @user.can_change_email? %>
        <p class="text-body">
          <%= link_to "Update your email address", edit_settings_email_update_path, class: class_names(text_link_classes, "font-medium") %>
          to continue receiving notifications.
        </p>
      <% else %>
        <p class="text-body">You can update your email address in <%= distance_of_time_in_words(@user.time_until_email_change_allowed) %>.</p>
      <% end %>
    <% end %>
  <% end %>

  <% if suggest_to_add_tokens %>
    <%= render PageHeaderComponent.new(title: "Status") do |header| %>
      <% header.with_context_paragraph "This is your dashboard. Once your feeds start importing, your activity and stats show up here." %>
      <% header.with_context_paragraph "Feeder needs a FreeFeed access token to post on your behalf, and there's no active token right now. Add one to get things moving." %>
    <% end %>
    <div>
      <%= link_to "Add FreeFeed token", new_access_token_path, class: primary_button_classes %>
    </div>
  <% elsif suggest_adding_feeds %>
    <%= render PageHeaderComponent.new(title: "Status") do |header| %>
      <% header.with_context_paragraph "This is your dashboard. Once your feeds start importing, your activity and stats show up here." %>
      <% header.with_context_paragraph "You've got a token set up. Now add a feed and Feeder will start reposting new content to FreeFeed." %>
    <% end %>
    <div>
      <%= link_to "Add a feed", new_feed_path, class: primary_button_classes %>
    </div>
  <% elsif suggest_finishing_drafts %>
    <%= render PageHeaderComponent.new(title: "Status") do |header| %>
      <% header.with_context_paragraph "This is your dashboard. Once your feeds start importing, your activity and stats show up here." %>
      <% if draft_feeds.one? %>
        <% header.with_context_paragraph "You're almost there. Your feed is saved as a draft: finish setting it up and enable it to start reposting." %>
      <% else %>
        <% header.with_context_paragraph "You're almost there. Your feeds are saved as drafts: finish setting one up and enable it to start reposting." %>
      <% end %>
    <% end %>
    <div>
      <%= link_to "Continue setup", draft_feeds.one? ? edit_feed_path(draft_feeds.first) : feeds_path, class: primary_button_classes %>
    </div>
  <% else %>
    <%= render PageHeaderComponent.new(title: "Status") %>
    <%= render UserStatsComponent.new(user: @user) %>
    <%= render PostsHeatmapComponent.new(user: @user) %>

    <section class="space-y-4">
      <%= h2 "Recent Activity" %>
      <%= render(EventsListComponent.new(
        events: @recent_events,
        endpoint: events_path(format: :turbo_stream, display: :brief, filter: @filter.to_h.presence),
        view_all_url: events_path(filter: @filter.to_h.presence)
      )) %>
    </section>
  <% end %>
</div>
