<% content_for :title, "Change Password" %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: "Change Password") %>

  <div class="max-w-2xl">
    <%= form_with model: @user, url: settings_password_update_path, method: :patch, local: true do |form| %>
      <div class="space-y-10">
        <div class="space-y-2">
          <%= form.label :current_password, "Current password", class: form_label_classes %>
          <%= form.password_field :current_password, class: input_field_classes, required: true, autofocus: true, autocomplete: "current-password" %>
        </div>

        <div class="space-y-2">
          <%= form.label :password, "New password", class: form_label_classes %>
          <%= form.password_field :password, class: input_field_classes, required: true, autocomplete: "new-password" %>
        </div>

        <div class="space-y-2">
          <%= form.label :password_confirmation, "Confirm new password", class: form_label_classes %>
          <%= form.password_field :password_confirmation, class: input_field_classes, required: true, autocomplete: "new-password" %>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-start gap-4 text-body">
        <%= form.submit "Change Password", class: primary_button_classes %>
        <%= link_to "Cancel", settings_path, class: secondary_button_classes %>
      </div>
    <% end %>
  </div>
</div>
