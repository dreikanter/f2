<% content_for :title, "Settings" %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: "Settings") do |header| %>
    <% if @user.permissions.any? %>
      <% header.with_context_paragraph do %>
        Permissions:
        <span class="text-heading" data-key="settings.permissions.value"><%= @user.permissions.map(&:display_name).join(", ") %></span>
      <% end %>
    <% end %>
  <% end %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <%= render LinkedCardComponent.new(
      href: edit_settings_name_update_path,
      title: "Your Name",
      icon: "user",
      description: name_hint_for(@user),
      data: {
        key: "settings.name"
      }
    ) %>

    <%= render LinkedCardComponent.new(
      href: edit_settings_email_update_path,
      title: "Change Email",
      icon: "mail",
      description: "Your current email is #{@user.email_address}",
      data: {
        key: "settings.email"
      }
    ) %>

    <%= render LinkedCardComponent.new(
      href: edit_settings_password_update_path,
      title: "Change Password",
      icon: "lock",
      description: "Last changed #{time_ago_in_words(@user.password_updated_at || @user.created_at)} ago",
      data: {
        key: "settings.password"
      }
    ) %>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <%= render LinkedCardComponent.new(
      href: access_tokens_path,
      title: "Freefeed Tokens",
      icon: "key-square",
      description: "Manage the tokens used for reposting to FreeFeed"
    ) %>

    <%= render LinkedCardComponent.new(
      href: ai_credentials_path,
      title: "AI Credentials",
      icon: "sparkles",
      description: "Connect AI provider keys for AI-backed feed extraction"
    ) %>

    <% if Rails.configuration.x.external_search_enabled %>
      <%= render LinkedCardComponent.new(
        href: search_credentials_path,
        title: "Search Credentials",
        icon: "search",
        description: "Connect search-provider keys for AI feeds that search the web"
      ) %>
    <% end %>

    <%= render LinkedCardComponent.new(
      href: invites_path,
      title: "Invites",
      icon: "mail",
      description: "Invite people to join Feeder"
    ) %>
  </div>
</div>
