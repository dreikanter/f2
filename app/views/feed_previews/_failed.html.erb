<%# locals: (preview:) %>
<div class="rounded-lg border border-danger-subtle bg-danger-subtle px-4 py-3 text-danger-strong space-y-3"
     role="alert"
     data-key="preview.failed"
     data-controller="preview"
     data-preview-refresh-url-value="<%= feed_preview_path(preview) %>"
     data-preview-done>
  <div class="space-y-1">
    <p class="font-semibold text-heading">We couldn't build a preview.</p>
    <% if preview.execution_limit_exceeded? %>
      <p class="text-body">The preview reached its time or search limit before finishing. Please try again.</p>
    <% elsif preview.ai_configuration_rejected? %>
      <p class="text-body">Check the AI model and web-search setting. Choose a supported model, or turn off web search for writing and text transformations.</p>
    <% else %>
      <p class="text-body">Something went wrong fetching this source. Double-check it and give it another go.</p>
    <% end %>
  </div>
  <%= tag.button "Try again", type: "button",
                 class: "inline-flex items-center gap-1 rounded-md border border-border bg-surface px-3 py-1.5 text-sm font-medium text-heading shadow-sm transition hover:bg-surface-muted",
                 data: { action: "click->preview#refresh", key: "preview.try-again" } %>
</div>
