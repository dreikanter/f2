<%# locals: (preview:) %>
<div class="space-y-4"
     data-controller="preview lightbox"
     data-preview-refresh-url-value="<%= feed_preview_path(preview) %>"
     data-key="preview.success"
     data-preview-done>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="space-y-1">
      <p class="font-semibold text-heading">Feed preview</p>
      <p class="text-sm text-muted" data-key="preview.summary">
        We found <%= pluralize(preview.total_entries_count, "item") %> in this feed.<% if preview.total_entries_count > preview.posts_count %> Showing <%= preview.posts_count %>.<% end %>
      </p>
      <% if preview.unidentified_entries_count.positive? %>
        <p class="text-sm text-warning" data-key="preview.unidentified">
          Skipped <%= pluralize(preview.unidentified_entries_count, "item") %> that couldn't be identified.
        </p>
      <% end %>
      <% if preview.rejected_posts_count.positive? %>
        <p class="text-sm text-warning" data-key="preview.rejected">
          <%= pluralize(preview.rejected_posts_count, "shown item") %> won't be posted. See the reasons below.
        </p>
      <% end %>
    </div>
    <button type="button"
            class="inline-flex items-center gap-1 rounded-md border border-border bg-surface px-3 py-1.5 text-sm font-medium text-heading shadow-sm transition hover:bg-surface-muted"
            data-action="click->preview#refresh"
            data-key="preview.refresh">
      Refresh
    </button>
  </div>

  <% if preview.posts_data.any? %>
    <div class="space-y-4">
      <% preview.posts_data.each_with_index do |post, index| %>
        <div data-key="preview.post.<%= index %>">
          <%= render PostPreviewComponent.new(post_data: post, index: index) %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-body" data-key="preview.empty">
      <%= preview.total_entries_count.positive? ? "No items to preview." : "No posts found in this feed." %>
    </p>
  <% end %>
</div>
