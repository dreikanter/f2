<%# locals: (feed:, refresh_status:, refresh_failed: false) %>
<% action_button = class_names(secondary_button_classes(compact: true), "cursor-pointer disabled:cursor-not-allowed disabled:opacity-50") %>
<% polling_data = if refresh_status.refreshing?
                    {
                      controller: "polling",
                      polling_endpoint_value: feed_path(feed, format: :turbo_stream, refresh_after: refresh_status.cursor),
                      polling_interval_value: 5_000,
                      polling_initial_delay_value: 5_000,
                      polling_max_polls_value: 60,
                      polling_indicate_busy_value: false,
                      last_event_id: refresh_status.event&.id
                    }
                  else
                    {}
                  end %>
<%= tag.div id: dom_id(feed, :header), class: "space-y-5", data: { key: "feed.header" }.merge(polling_data) do %>
  <%= render PageHeaderComponent.new(title: feed.display_name) do |header| %>
    <% header.with_title_suffix do %>
      <%= render FeedRefreshStatusComponent.new(status: refresh_status) %>
    <% end %>
    <% header.with_breadcrumb(label: "Feeds", url: feeds_path) %>
    <% header.with_context_paragraph do %>
      <%= render feed_status_badge(feed) %>
    <% end %>
    <% if feed.target_group.present? %>
      <% header.with_context_paragraph do %>
        Target group:
        <%= feed_target_group_link(feed) %>
      <% end %>
    <% end %>
    <% if feed.enabled? %>
      <% header.with_action_button do %>
        <%= button_to "Disable",
                      feed_status_path(feed),
                      method: :patch,
                      params: { status: "disabled" },
                      data: { turbo_confirm: "Disable this feed?" },
                      class: action_button,
                      form: { class: "inline-block" } %>
      <% end %>
    <% elsif feed.can_be_enabled? %>
      <% header.with_action_button do %>
        <%= button_to "Enable",
                      feed_status_path(feed),
                      method: :patch,
                      params: { status: "enabled" },
                      data: { turbo_confirm: "Enable this feed?" },
                      class: action_button,
                      form: { class: "inline-block" } %>
      <% end %>
    <% else %>
      <% header.with_action_button do %>
        <button type="button" disabled title="<%= feed_enable_hint(feed) %>" class="<%= action_button %>">Enable</button>
      <% end %>
    <% end %>
    <% header.with_action_button do %>
      <%= render HeaderMenuComponent.new(menu_id: "feed-header-menu-#{feed.id}", items: feed_actions_menu_items(feed), width: "w-44") %>
    <% end %>
  <% end %>

  <% if refresh_status.refreshing? || refresh_failed %>
    <%= tag.div hidden: !refresh_failed, data: { polling_target: "timeoutMessage" } do %>
      <%= render AlertComponent.new(variant: :error, data: { key: "feed.refresh-notice" }) do %>
        <% if refresh_failed %>
          Couldn't refresh the feed. See Recent Activity for details.
        <% else %>
          Couldn't check the refresh. Reload the page to check its progress.
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# The disabled Enable button carries the same hint, but a title on a
      disabled button goes unseen in most browsers. %>
  <% unless feed.enabled? || feed.can_be_enabled? %>
    <%= render AlertComponent.new(variant: :warning, icon: "triangle-alert", data: { key: "feed.enable_hint" }) do %>
      <p><%= feed_enable_hint(feed) %></p>
    <% end %>
  <% end %>
<% end %>
