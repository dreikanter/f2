<% content_for :title, @feed.display_name %>

<div class="space-y-10">
  <%= render "header", feed: @feed %>

  <% if @feed.webhook_endpoint %>
    <section class="space-y-4">
      <%= h2 "Webhook API" %>
      <%= render "webhook_endpoint_panel", feed: @feed, endpoint: @feed.webhook_endpoint %>
    </section>
  <% end %>

  <% unless @feed.draft? %>
    <section class="space-y-4">
      <%= h2 "Stats" %>
      <%= render FeedStatsComponent.new(feed: @feed) %>
      <%= render PostsHeatmapComponent.new(feed: @feed) %>
    </section>
  <% end %>

  <% if @has_llm_usages %>
    <section class="space-y-4">
      <%= h2 "AI Usage" %>
      <%= render FeedLlmStatsComponent.new(feed: @feed) %>
    </section>
  <% end %>

  <% if @recent_events.any? %>
    <section class="space-y-4">
      <%= h2 "Recent Activity" %>
      <%= render EventsListComponent.new(events: @recent_events, view_all_url: events_path(filter: { subject_type: "Feed", subject_id: @feed.id })) %>
    </section>
  <% end %>

  <% if @recent_posts.any? %>
    <section class="space-y-4">
      <%= h2 "Recent Posts" %>
      <%= render PostsListComponent.new(posts: @recent_posts, show_feed: false, view_all_url: posts_path(feed_id: @feed.id)) %>
    </section>
  <% end %>
</div>

<% if @feed.target_group.present? %>
  <%= render ConfirmationModalComponent.new(
    title: "Confirm Purge",
    action: "Purge feed",
    url: feed_purge_path(@feed),
    method: :post,
    modal_id: "purge-modal-#{@feed.id}"
  ) do %>
    <%= render AlertComponent.new(variant: :warning) do %>
      <p>This removes only the posts this feed published to <strong><%= @feed.target_group %></strong> on FreeFeed.</p>
      <p>Other posts in the group, including anything added by other people, aren't affected.</p>
      <p>Feeder keeps its own record of the removed posts, so they'll still show up here and won't be posted again the next time this feed refreshes.</p>
      <p>This can't be undone.</p>
    <% end %>
  <% end %>
<% end %>

<%= render "delete_modal", feed: @feed %>
