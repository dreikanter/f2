<%# locals: (url: nil, prompt: nil, mode: "link", checking: false, error: nil) %>
<%# Each mode keeps its own form so only its fields validate and submit.
    A shared action row follows the radio group, outside the forms. %>
<%
  wrapper_data = { controller: "mode-switch",
                   identification_state: checking ? "checking" : ("error" if error) }
  if checking
    wrapper_data.merge!(
      controller: "mode-switch polling",
      polling_indicate_busy_value: false,
      polling_endpoint_value: feed_identification_path(url: url),
      polling_interval_value: FeedIdentification::POLLING_INTERVAL_MS,
      polling_max_polls_value: FeedIdentification.polling_max_polls,
      polling_stop_condition_value: FeedFormComponent::POLLING_STOP_CONDITION
    )
  end
%>
<%= tag.div id: "feed-form", data: wrapper_data do %>
  <fieldset>
    <legend class="sr-only">How do you want to follow this?</legend>

    <div class="space-y-6">
      <div class="space-y-3">
        <label class="flex items-center gap-3 font-semibold text-heading" data-key="entry.mode-link">
          <%= radio_button_tag "entry_mode", "link", mode == "link",
                               disabled: checking,
                               data: { mode_switch_target: "radio", action: "change->mode-switch#switch" } %>
          Follow a feed or channel
        </label>

        <%= tag.div class: "ps-7", hidden: mode != "link",
                    data: { key: "entry.panel-link", mode: "link", mode_switch_target: "panel" } do %>
          <%= form_with url: feed_identification_path, method: :post, id: "entry-link-form", class: "aria-busy:opacity-100" do |f| %>
            <div class="space-y-2">
              <%# The radio label is the group's one visible label; the field
                  keeps its name for assistive tech only. %>
              <%= f.text_field :url,
                               id: "entry-link-input",
                               value: url,
                               placeholder: "https://example.com",
                               class: input_field_classes(disabled: true),
                               required: true,
                               disabled: checking,
                               autofocus: mode == "link" && !checking,
                               aria: { label: "Source link" },
                               data: { key: "form.entry-link" } %>
              <% if checking %>
                <p class="flex items-center gap-2 text-sm text-muted" role="status" data-key="entry.checking-status">
                  <%= icon "loader-circle", css_class: "size-4 animate-spin" %>
                  <span>Checking this feed. This usually takes a few seconds.</span>
                </p>
              <% elsif error && mode == "link" %>
                <p class="text-sm text-danger" data-key="entry.error"><%= error %></p>
              <% else %>
                <p class="text-sm text-muted">A blog, YouTube channel, subreddit, or any site with a feed.</p>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>

      <% if Features.ai? %>
        <div class="space-y-3">
          <label class="flex items-center gap-3 font-semibold text-heading" data-key="entry.mode-ai">
            <%= radio_button_tag "entry_mode", "ai", mode == "ai",
                                 disabled: checking,
                                 data: { mode_switch_target: "radio", action: "change->mode-switch#switch" } %>
            Follow with AI
          </label>

          <%= tag.div class: "ps-7", hidden: mode != "ai",
                      data: { key: "entry.panel-ai", mode: "ai", mode_switch_target: "panel" } do %>
            <%= form_with url: feed_identification_path, method: :post, id: "entry-ai-form" do |f| %>
              <div class="space-y-2">
                <%= f.text_area :prompt,
                                id: "entry-ai-input",
                                rows: 3,
                                maxlength: 2000,
                                value: prompt,
                                placeholder: "e.g. Follow A24's blog and turn each new post into a one-line announcement",
                                class: input_field_classes,
                                required: true,
                                autofocus: mode == "ai",
                                aria: { label: "What should AI follow?" },
                                data: { key: "form.entry-ai" } %>
                <% if error && mode == "ai" %>
                  <p class="text-sm text-danger" data-key="entry.error"><%= error %></p>
                <% else %>
                  <p class="text-sm text-muted">Describe a source or topic in your own words. Use a link, a few links, or explain what you're after. AI reads the web to keep up with it.</p>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-3">
        <label class="flex items-center gap-3 font-semibold text-heading" data-key="entry.mode-webhook">
          <%= radio_button_tag "entry_mode", "webhook", mode == "webhook",
                               disabled: checking,
                               data: { mode_switch_target: "radio", action: "change->mode-switch#switch" } %>
          Post via webhook
        </label>

        <%= tag.div class: "ps-7", hidden: mode != "webhook",
                    data: { key: "entry.panel-webhook", mode: "webhook", mode_switch_target: "panel" } do %>
          <%= form_with url: feed_identification_path, method: :post, id: "entry-webhook-form" do |f| %>
            <div class="space-y-2">
              <%= f.hidden_field :webhook, value: "1" %>
              <% if error && mode == "webhook" %>
                <p class="text-sm text-danger" data-key="entry.error"><%= error %></p>
              <% else %>
                <p class="text-sm text-muted">There is nothing to follow. You send posts to a webhook endpoint using a secret authorization token. A single curl command is enough.</p>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </fieldset>

  <div class="mt-6 flex flex-wrap items-center justify-start gap-4 text-body" data-key="entry.actions">
    <%= submit_tag checking ? "Checking…" : "Continue",
                   form: "entry-#{mode}-form",
                   disabled: checking,
                   class: "#{primary_button_classes} disabled:bg-brand disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:bg-brand",
                   data: {
                     key: "entry.submit",
                     mode_switch_target: "submit",
                     turbo_submits_with: mode == "link" ? "Checking…" : "Preparing…"
                   } %>
    <% if checking %>
      <%= link_to "Cancel", feed_identification_path(url: url), class: secondary_button_classes,
                  data: { turbo_method: :delete, key: "entry.cancel-check" } %>
    <% else %>
      <%= link_to "Cancel", feeds_path, class: secondary_button_classes %>
    <% end %>
  </div>
<% end %>
