<% content_for :title, "Dev Tools" %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: "Dev Tools") %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <%= render LinkedCardComponent.new(
      href: development_system_status_path,
      title: "System Status",
      icon: "hard-drive",
      description: "Check configuration, disk usage, and other system info"
    ) %>

    <%= render LinkedCardComponent.new(
      href: mission_control_jobs.root_path,
      title: "Background Jobs",
      icon: "hard-hat",
      description: "Monitor and manage background job queues",
      target: "_blank",
      rel: "noopener noreferrer"
    ) %>

    <%= render LinkedCardComponent.new(
      href: development_jobs_path,
      title: "Maintenance Jobs",
      icon: "circle-play",
      description: "Run maintenance jobs and browse their run history"
    ) %>

    <%= render LinkedCardComponent.new(
      href: development_llm_models_path,
      title: "LLM Models",
      icon: "sparkles",
      description: "Check the stored model catalog and refresh it"
    ) %>

    <%= render LinkedCardComponent.new(
      href: admin_llm_chats_path,
      title: "AI API Log",
      icon: "message-circle",
      description: "Inspect AI provider requests, responses, and usage"
    ) %>

    <%= render LinkedCardComponent.new(
      href: development_email_previews_path,
      title: "Email Previews",
      icon: "mail",
      description: "Browse rendered previews of all email templates"
    ) %>

    <%= render LinkedCardComponent.new(
      href: development_sent_emails_path,
      title: "Sent Emails",
      icon: "inbox",
      description: "Review emails captured in development",
      disabled: !@sent_emails_available,
      tooltip: @sent_emails_available ? nil : "Email capture is not configured"
    ) %>

    <%= render LinkedCardComponent.new(
      href: development_components_path,
      title: "UI Reference",
      icon: "layout-grid",
      description: "Reference for all reusable UI components."
    ) %>
  </div>
</div>
