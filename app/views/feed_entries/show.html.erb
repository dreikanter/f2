<% feed_entry_title = "Feed Entry #{short_ref(@feed_entry.id)}" %>
<% content_for :title, feed_entry_title %>
<% post = @feed_entry.posts.first %>

<div class="space-y-8">
  <%= render PageHeaderComponent.new(title: feed_entry_title) do |header| %>
    <% if post %>
      <% header.with_breadcrumb(label: "Post #{short_ref(post.id)}", url: post_path(post)) %>
    <% end %>
    <% header.with_context_paragraph do %>
      <%= render BadgeComponent.new(
        text: @feed_entry.status.capitalize,
        color: feed_entry_status_badge_color(@feed_entry.status),
        key: "feed_entry.status_badge"
      ) %>
    <% end %>
  <% end %>

  <div class="overflow-hidden rounded-lg border border-border bg-surface p-4">
    <pre class="text-heading text-sm overflow-x-auto"><%= JSON.pretty_generate(@feed_entry.as_json) %></pre>
  </div>
</div>
