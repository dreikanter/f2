<% content_for :title, "Update Password" %>

<%= render ModalCardComponent.new do %>
  <div class="space-y-6">
    <%= h1 "Choose a new password" %>
    <p class="text-sm text-body">Enter and confirm a new password to finish resetting your account.</p>

    <% if flash[:alert] %>
      <%= render AlertComponent.new(variant: :error) do %>
        <span><%= flash[:alert] %></span>
      <% end %>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, local: true do |form| %>
      <div class="space-y-10">
        <div class="space-y-2">
          <%= form.label :password, "New password", class: form_label_classes %>
          <%= form.password_field :password,
                                  required: true,
                                  autofocus: true,
                                  autocomplete: "new-password",
                                  placeholder: "Enter a new password",
                                  maxlength: User::PASSWORD_MAX_LENGTH,
                                  class: input_field_classes %>
        </div>

        <div class="space-y-2">
          <%= form.label :password_confirmation, "Confirm password", class: form_label_classes %>
          <%= form.password_field :password_confirmation,
                                  required: true,
                                  autocomplete: "new-password",
                                  placeholder: "Repeat the new password",
                                  maxlength: User::PASSWORD_MAX_LENGTH,
                                  class: input_field_classes %>
        </div>
      </div>

      <div class="mt-6 flex flex-col items-start justify-start gap-4 text-body sm:flex-row sm:items-center sm:justify-between">
        <%= form.submit "Save password", class: class_names(primary_button_classes, "w-full sm:w-auto") %>
        <p><%= link_to "Back to sign in", new_session_path, class: class_names(text_link_classes, "inline-block font-medium leading-loose") %></p>
      </div>
    <% end %>
  </div>
<% end %>
