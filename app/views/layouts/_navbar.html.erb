<%# locals: () %>
<nav class="bg-surface-sunken border-b border-border">
  <div class="flex flex-wrap items-center justify-between mx-auto px-4 py-4">
    <%= link_to "F2", root_path, class: "inline-flex items-center text-lg font-semibold text-heading rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-white" %>

    <div class="flex items-center gap-3 md:order-2">
      <% if Current.user.present? %>
        <%# User menu button (desktop) %>
        <button type="button" class="hidden md:flex items-center justify-center w-8 h-8 rounded-full bg-surface-inverted text-on-brand text-sm font-semibold cursor-pointer disabled:cursor-not-allowed focus:outline-none focus:ring-4 focus:ring-ring" id="user-menu-button" aria-expanded="false" data-dropdown-toggle="user-dropdown" data-dropdown-placement="bottom-end">
          <span class="sr-only">Open user menu</span>
          <%= Current.user.email_address[0].upcase %>
        </button>

        <%# User dropdown menu (desktop) %>
        <div class="z-50 hidden my-4 text-base list-none bg-surface divide-y divide-border rounded-lg shadow-sm border border-border" id="user-dropdown">
          <div class="px-4 py-3">
            <span class="block text-sm text-heading font-medium"><%= Current.user.email_address %></span>
          </div>
          <% user_menu_item_groups.each_with_index do |group, group_index| %>
            <%= tag.ul class: "py-2", aria: { labelledby: ("user-menu-button" if group_index.zero?) } do %>
              <% group.each do |item| %>
                <li><%= link_to item[:name], item[:path], class: user_menu_link_classes %></li>
              <% end %>
            <% end %>
          <% end %>
          <ul class="py-2">
            <li>
              <%= link_to "Sign Out", session_path, data: { turbo_method: :delete }, class: user_menu_link_classes %>
            </li>
          </ul>
        </div>

        <%# Mobile menu toggle %>
        <button data-collapse-toggle="primary-navigation" type="button" class="inline-flex items-center justify-center rounded-lg p-2 text-sm text-body cursor-pointer disabled:cursor-not-allowed hover:bg-surface-sunken focus:outline-none focus:ring-2 focus:ring-ring md:hidden" aria-controls="primary-navigation" aria-expanded="false">
          <span class="sr-only">Toggle navigation</span>
          <%= icon("menu", css_class: "size-5") %>
        </button>
      <% end %>
    </div>

    <div class="hidden w-full md:block md:w-auto md:order-1" id="primary-navigation">
      <%# Desktop: horizontal nav links %>
      <ul class="hidden font-medium text-body md:flex md:flex-row md:items-center md:space-x-4">
        <% navbar_items.each do |item| %>
          <%
            desktop_link_classes = class_names(
              "inline-flex items-center rounded-sm px-3 py-2 transition-colors duration-150 md:px-3 md:py-1",
              {
                "bg-surface-inverted text-on-brand" => item[:active],
                "text-body hover:bg-surface-sunken hover:text-heading" => !item[:active]
              },
              "outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-white"
            )
          %>
          <li>
            <%= link_to item[:name], item[:path],
                class: class_names(desktop_link_classes, "md:block hidden"),
                aria: (item[:active] ? { current: "page" } : nil) %>
          </li>
        <% end %>
      </ul>

      <%# Mobile: List group 1 - Main nav items %>
      <div class="mt-4 rounded-lg border border-border bg-surface md:hidden">
        <% navbar_items.each_with_index do |item, index| %>
          <%= link_to item[:name], item[:path],
              class: mobile_nav_link_classes(active: item[:active], first: index.zero?, last: index == navbar_items.length - 1),
              aria: (item[:active] ? { current: "page" } : nil) %>
        <% end %>
      </div>

      <% if Current.user.present? %>
        <%# Mobile: List group 2 - User menu items %>
        <div class="mt-3 rounded-lg border border-border bg-surface md:hidden">
          <% user_menu_items.each_with_index do |item, index| %>
            <%= link_to item[:name], item[:path],
                class: mobile_nav_link_classes(active: item[:active], first: index.zero?, last: index == user_menu_items.length - 1),
                aria: (item[:active] ? { current: "page" } : nil) %>
          <% end %>
        </div>

        <%# Mobile: List group 3 - Sign Out %>
        <div class="mt-3 rounded-lg border border-border bg-surface md:hidden">
          <%= link_to "Sign Out", session_path,
              data: { turbo_method: :delete },
              class: "block w-full px-4 py-4 text-heading rounded-lg cursor-pointer hover:bg-surface-sunken hover:text-heading focus:outline-none focus:ring-2 focus:ring-ring focus:text-heading" %>
        </div>
      <% end %>
    </div>
  </div>
</nav>
