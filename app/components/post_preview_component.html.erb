<%= render(CardComponent.new(id: card_id)) do |card| %>
  <% if uid %>
    <% card.with_section(class: "px-4 py-2") do %>
      <div class="flex items-center gap-3 text-xs">
        <span class="w-20 shrink-0 text-muted">UID:</span>
        <span class="min-w-0 truncate text-heading" title="<%= uid %>"><%= uid %></span>
      </div>
    <% end %>
  <% end %>

  <% if published_at %>
    <% card.with_section(class: "px-4 py-2") do %>
      <div class="flex items-center gap-3 text-xs">
        <span class="w-20 shrink-0 text-muted">Published:</span>
        <time datetime="<%= published_at.iso8601 %>" title="<%= published_at %>"><%= published_compact %></time>
      </div>
    <% end %>
  <% end %>

  <% if source_url %>
    <% card.with_section(class: "px-4 py-2") do %>
      <div class="flex items-center gap-3 text-xs">
        <span class="w-20 shrink-0 text-muted">URL:</span>
        <span class="min-w-0 truncate">
          <%= link_to source_url, source_url, target: "_blank", rel: "noopener",
                class: class_names(helpers.text_link_classes, "font-medium") %>
        </span>
      </div>
    <% end %>
  <% end %>

  <% if formatted_content || attachments? || comments? %>
    <% card.with_section(class: "p-4") do %>
      <div class="space-y-4">
        <% if formatted_content %>
          <%= formatted_content %>
        <% end %>

        <% if attachments? %>
          <section class="space-y-2" data-key="preview.attachments">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Attachments</p>
            <div class="flex flex-wrap gap-2">
              <% attachments.each_with_index do |url, attachment_index| %>
                <%= render AttachmentThumbnailComponent.new(url: url, position: attachment_index + 1,
                      key: "preview.image-attachment") %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if comments? %>
          <section class="space-y-2" data-key="preview.comments">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Comments</p>
            <div class="space-y-3">
              <%= helpers.render "posts/comments", comments: comments, key: "preview.comment" %>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
