<div class="space-y-6" data-key="<%= key %>.show">
  <%= render PageHeaderComponent.new(title: credential.display_name) do |header| %>
    <% header.with_breadcrumb(label: breadcrumb, url: breadcrumb_url) %>
    <% unless credential.pending? || credential.validating? %>
      <% header.with_context_paragraph do %>
        <%= render helpers.credential_state_badge(credential) %>
      <% end %>
    <% end %>
    <% header.with_action_button do %>
      <%= render HeaderMenuComponent.new(menu_id: menu_id, items: helpers.credential_actions_menu_items(credential)) %>
    <% end %>
  <% end %>

  <%= render CredentialDeleteModalComponent.new(credential: credential) %>

  <% case credential.state %>
  <% when "pending", "validating" %>
    <%# aria-busy disables pointer events, so it stays on the waiting block;
        on the page it would take the breadcrumb and menus down with it. %>
    <div class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3"
         data-key="<%= key %>.validating" aria-busy="true">
      <div class="flex-shrink-0"><%= render SpinnerComponent.new %></div>
      <div class="space-y-1">
        <p class="font-semibold text-heading">Checking your credential…</p>
        <p class="text-body"><%= checking_note %></p>
      </div>
    </div>
  <% when "active" %>
    <%= details %>
    <%= active_extra %>
  <% when "inactive" %>
    <p class="max-w-2xl text-body" data-key="<%= key %>.inactive">
      <%= credential.last_error.presence || rejected_note %>
    </p>
    <%= details %>
  <% end %>

  <%= settled_extra if settled? %>

  <% if feed_id.present? %>
    <div class="flex flex-wrap gap-3">
      <% if credential.active? %>
        <%= link_to "Continue setting up your feed", edit_feed_path(feed_id),
                    class: helpers.primary_button_classes(compact: true), data: { key: "#{key}.return-to" } %>
      <% else %>
        <%= link_to "Back to your feed", edit_feed_path(feed_id),
                    class: helpers.secondary_button_classes(compact: true), data: { key: "#{key}.return-to" } %>
      <% end %>
    </div>
  <% end %>
</div>
