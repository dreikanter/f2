<%= render ModalComponent.new(title: @title, modal_id: @modal_id) do |modal| %>
  <%= content %>

  <% modal.with_footer do %>
    <%= button_to @action,
                  @url,
                  method: @method,
                  class: helpers.danger_button_classes,
                  data: { action: "modal#confirm" } %>
    <%= tag.button "Cancel",
                   type: "button",
                   class: class_names(helpers.secondary_button_classes(compact: true), "cursor-pointer disabled:cursor-not-allowed disabled:opacity-50"),
                   data: { action: "modal#close" } %>
  <% end %>
<% end %>
