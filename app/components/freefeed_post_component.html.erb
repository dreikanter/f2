<div class="w-full rounded-lg border border-border bg-surface p-4" data-key="freefeed_post">
  <%# On narrow screens the avatar floats so the text wraps around it; from sm:
      up the container turns into a grid (grid items ignore float) where the
      avatar spans the header and body rows, keeping both top-aligned and
      tight. flow-root contains the float when the text is shorter than the
      avatar. %>
  <div class="flow-root sm:grid sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-x-3 sm:gap-y-1">
    <%= render UserpicComponent.new(url: userpic_url,
          css_class: "float-left mr-3 mb-1 size-12 rounded-md border border-border sm:row-span-2 sm:mr-0 sm:mb-0",
          data: { key: "freefeed_post.avatar" }) %>

    <div class="min-w-0 mb-2 text-heading sm:mb-0">
      <span class="font-semibold" data-key="freefeed_post.author"><%= author_name %></span>
      <% if group_name.present? %>
        <span class="text-muted">to</span>
        <% if group_url %>
          <%= link_to group_name, group_url, target: "_blank", rel: "noopener",
                class: "font-semibold text-brand transition hover:text-brand-hover",
                data: { key: "freefeed_post.group" } %>
        <% else %>
          <span class="font-semibold" data-key="freefeed_post.group"><%= group_name %></span>
        <% end %>
      <% end %>
    </div>

    <div class="min-w-0 space-y-3">
      <% if post.content.present? %>
        <div class="text-heading" data-key="freefeed_post.content"><%= helpers.format_post_content(post.content) %></div>
      <% end %>

      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted" data-key="freefeed_post.footer">
        <%= helpers.icon("globe", css_class: "size-4", title: "This entry is public") %>
        <% if freefeed_url %>
          <%= link_to timestamp_tag, freefeed_url, target: "_blank", rel: "noopener",
                class: "transition hover:text-body",
                data: { key: "freefeed_post.timestamp" } %>
        <% else %>
          <span data-key="freefeed_post.timestamp"><%= timestamp_tag %></span>
        <% end %>
        <%# Decorative echo of FreeFeed's action links; not functional here. %>
        <span class="flex select-none items-center gap-2" aria-hidden="true" data-key="freefeed_post.actions">
          <span>-</span>
          <span>Comment</span>
          <span>Save</span>
          <span>Hide</span>
          <span class="inline-flex items-center gap-0.5">More<%= helpers.icon("chevron-down", css_class: "size-3.5") %></span>
        </span>
      </div>

      <% if attachment_urls.present? %>
        <div class="flex flex-wrap gap-3" data-controller="lightbox" data-key="freefeed_post.attachments">
          <% attachment_urls.each_with_index do |url, attachment_index| %>
            <%= render AttachmentThumbnailComponent.new(url: url, position: attachment_index + 1,
                  key: "freefeed_post.image-attachment", alt: extract_filename(url)) %>
          <% end %>
        </div>
      <% end %>

      <% if comments.present? %>
        <div class="space-y-3" data-key="freefeed_post.comments">
          <%= helpers.render "posts/comments", comments: comments, key: "freefeed_post.comment" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
