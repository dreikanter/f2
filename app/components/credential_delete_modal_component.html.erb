<%= render ConfirmationModalComponent.new(
  title: "Delete #{credential_type}",
  action: "Delete #{credential_type.downcase}",
  url: helpers.polymorphic_path(credential),
  method: :delete,
  modal_id: modal_id
) do %>
  <%= render AlertComponent.new(variant: :warning) do %>
    <p>The <%= credential_type.downcase %> <em><%= credential.display_name %></em> will be permanently removed.</p>
    <p>Any feeds using it will be automatically disabled.</p>
    <p>This can't be undone.</p>
  <% end %>
<% end %>
